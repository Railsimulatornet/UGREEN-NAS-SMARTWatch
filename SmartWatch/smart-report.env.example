# Copyright Roman Glos 2026
# UGREEN SMART Report configuration / Konfiguration

# Language for console, report and mail output / Sprache für Konsole, Report und Mail
# Supported values / Unterstützte Werte: de, en
LANGUAGE="de"

# Optional custom NAS name / Optionaler Zusatzname für den NAS-Namen
# Example / Beispiel: NAS_CUSTOM_NAME="Backup NAS"
NAS_CUSTOM_NAME=""

# Optional model override / Optionales Modell-Override
# Leave empty for automatic detection / Leer lassen für automatische Erkennung
# Supported values / Unterstützte Werte:
# DH2300
# DH4300PLUS
# DXP2800
# DXP2800GT
# DXP4800
# DXP4800GT
# DXP4800PRO
# DXP4800PLUS
# DX4700
# DXP6800PLUS
# DXP6800PRO
# DXP6800ULTRA
# DXP8800PLUS
# DXP8800PRO
# DXP8800ULTRA
# DXP480TPLUS
# IDX6011
# IDX6011PRO
NAS_MODEL_OVERRIDE=""

# Logging / Protokollierung
# Directory for log files / Ordner für Logdateien
LOG_DIR="/volume2/NASAdmin/Logs/SmartWatch"

# Delete old log files after X days / Alte Logdateien nach X Tagen löschen
LOG_RETENTION_DAYS=30

# Monthly log file name / Monatlicher Name der Logdatei
LOG_FILE="${LOG_DIR}/ugreen-smart-report_$(date '+%Y-%m').log"

# Shutdown after monthly long test / Nach monatlichem Langtest herunterfahren
# Supported values / Unterstützte Werte: true, false
SHUTDOWN_AFTER_LONG="false"

# eMMC checks / eMMC-Prüfungen
# Enable eMMC detection and status check / eMMC-Erkennung und Zustandsprüfung aktivieren
EMMC_ENABLE_CHECK="true"

# Enable optional eMMC read test if supported / Optionalen eMMC-Lesetest aktivieren, falls unterstützt
EMMC_ENABLE_READTEST="true"

# Include USB drives in SMART detection and report / USB-Laufwerke in SMART-Erkennung und Report einbeziehen
# Supported values / Unterstützte Werte: true, false
INCLUDE_USB_DRIVES="true"

# Maximum wait times for running NVMe self-tests / Maximale Wartezeiten für laufende NVMe-Selbsttests
# After this time the script will try to abort still running NVMe self-tests
# Nach Erreichen dieser Zeit versucht das Skript noch laufende NVMe-Selbsttests abzubrechen
NVME_MAX_WAIT_SHORT_MIN=15
NVME_MAX_WAIT_LONG_MIN=240

# Early stall detection for NVMe self-tests / Früherkennung festhängender NVMe-Selbsttests
# If progress no longer changes, the script can abort earlier
# Wenn sich der Fortschritt nicht mehr verändert, kann das Skript früher abbrechen
NVME_STALL_DETECTION=true
NVME_STALL_MIN_ELAPSED_SHORT_MIN=3
NVME_STALL_MIN_ELAPSED_LONG_MIN=30
NVME_STALL_POLLS_SHORT=3
NVME_STALL_POLLS_LONG=3

# Abort already running SMART tests before a new test run / Laufende SMART-Tests vor neuem Testlauf abbrechen
# Supported values / Unterstützte Werte: true, false
ABORT_RUNNING_TESTS_BEFORE_START="false"

# SMTP / Mail
# SMTP server hostname or IP / SMTP-Servername oder IP-Adresse
# Example / Beispiel: SMTP_SERVER="mail.example.com"
SMTP_SERVER=""

# SMTP port / SMTP-Port
# Example / Beispiel: 587 for STARTTLS, 465 for SSL
SMTP_PORT=587

# SMTP username / SMTP-Benutzername
# Example / Beispiel: SMTP_USER="nas@example.com"
SMTP_USER=""

# SMTP password / SMTP-Passwort
SMTP_PASS=""

# Sender address / Absenderadresse
# Example / Beispiel: MAIL_FROM="nas@example.com"
MAIL_FROM=""

# Recipient address / Empfängeradresse
# Example / Beispiel: MAIL_TO="admin@example.com"
MAIL_TO=""

# Use STARTTLS / STARTTLS verwenden
# Supported values / Unterstützte Werte: true, false
SMTP_USE_TLS="true"

# Use implicit SSL / Implizites SSL verwenden
# Supported values / Unterstützte Werte: true, false
SMTP_USE_SSL="false"
